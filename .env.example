# IdentityServer4 (https://identity.citytech.ec)
ARPSIS_AUTHORITY=https://identity.citytech.ec
ARPSIS_API_BASE=https://project.citytech.ec/api/v1

# OIDC client — from Chrome DevTools → Application → Local Storage → oidc.user:...
ARPSIS_CLIENT_ID=
ARPSIS_SCOPE=openid profile services offline_access roles

# Auth (pick one):
# 0. RECOMMENDED for vue.client — login session cookie of identity.citytech.ec.
#    vue.client is implicit-flow only (no refresh_token is ever issued), so the
#    MCP renews the access token itself with prompt=none, exactly like the web
#    app does every hour. Set it with `bun run set-session` (reads the cookie
#    from the clipboard and tests it). Renewed tokens/cookies are written back here.
ARPSIS_SESSION_COOKIE=
# Registered redirect_uri for vue.client; silent renew reads the token from its fragment.
# ARPSIS_REDIRECT_URI=https://project.citytech.ec/callback
# 1. Refresh token (only for clients that allow authorization_code + offline_access)
ARPSIS_REFRESH_TOKEN=
# 2. Static access token when refresh_token is unavailable (smoke tests / short sessions)
ARPSIS_ACCESS_TOKEN=
# DEPRECATED / optional — expiry is read from JWT `exp` automatically.
# Only set if your token is not a JWT or lacks an exp claim.
# ARPSIS_ACCESS_TOKEN_EXPIRES_AT=
# 3. Client credentials (confidential clients only)
ARPSIS_CLIENT_SECRET=

# Optional defaults
ARPSIS_DEFAULT_PROJECT_ID=0e166a8e-5a79-4f2d-a69c-2fcbf894bf34
ARPSIS_DEFAULT_DEPARTMENT_ID=b99808e4-87d7-46f5-a09c-99926ecc3681

# HTTP server mode (bun run start-http). Only ARPSIS_AUTHORITY / ARPSIS_API_BASE
# are read from here in HTTP mode — each user's bearer arrives in the request
# Authorization header, so REFRESH_TOKEN / ACCESS_TOKEN / CLIENT_SECRET above
# are IGNORED by the HTTP server (they still work for stdio mode).
ARPSIS_HTTP_PORT=8787
ARPSIS_HTTP_HOST=127.0.0.1
# Requests per minute per bearer (token-bucket, burst=rpm). 0 disables the limit.
ARPSIS_HTTP_RPM=120
# Log level: debug | info | warn | error (default: info). Stderr, JSON lines.
ARPSIS_LOG_LEVEL=info
